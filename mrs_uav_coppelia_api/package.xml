<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">

  <name>mrs_uav_coppelia_api</name>
  <version>1.0.0</version>
  <description>CoppeliaSim HW API for MRS UAV System</description>

  <author email="tomas.baca@fel.cvut.cz">Tomas Baca</author>
  <maintainer email="tomas.baca@fel.cvut.cz">Tomas Baca</maintainer>

  <license>BSD 3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_ros</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_components</depend>
  <depend>mrs_lib</depend>
  <depend>mrs_uav_hw_api</depend>
  <depend>mrs_msgs</depend>
  <depend>std_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>

  <depend>pluginlib</depend>
  <depend>python3-zmq</depend>

  <export>
    <build_type>ament_cmake</build_type>
    <mrs_uav_hw_api plugin="${prefix}/plugins.xml" />
  </export>

</package>
